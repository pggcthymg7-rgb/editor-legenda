{
  "name": "editor-legenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editor de legendas animadas estilo reels: transcrição, modelos editáveis e export para Premiere/CapCut.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"npm:web\"",
    "web": "vite",
    "server": "tsx watch server/index.ts",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src server cloud tests",
    "verify": "npm run typecheck && npm run lint && npm test && vite build && vite build --mode pwa",
    "build:pwa": "vite build --mode pwa",
    "preview:pwa": "vite preview --mode pwa --outDir dist-pwa --host 127.0.0.1 --port 4173"
  },
