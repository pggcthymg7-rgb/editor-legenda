{
  "name": "editor-legenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editor de legendas animadas estilo reels: transcrição, modelos editáveis e export para Premiere/CapCut.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"npm:web\"",
    "web": "vite",
    "server": "tsx watch server/index.ts",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && vite build && vite build --mode pwa",
    "build:pwa": "vite build --mode pwa",
    "preview:pwa": "vite preview --mode pwa --outDir dist-pwa --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@huggingface/transformers": "4.2.0",
    "@mediabunny/aac-encoder": "1.64.0",
    "@remotion/bundler": "4.0.540",
    "@remotion/captions": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/player": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/web-renderer": "4.0.540",
    "@remotion/whisper-webgpu": "4.0.540",
    "express": "5.1.0",
    "mediabunny": "1.64.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "concurrently": "9.1.2",
    "fake-indexeddb": "6.2.7",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.5",
    "workbox-build": {
      "glob": "14.0.3"
    }
  },
  "packageManager": "npm@11.6.2"
}
